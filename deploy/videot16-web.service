[Unit]
Description=VideoT16: локальная веб-панель настроек оператора
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oleg
Group=oleg
WorkingDirectory=/home/oleg/VideoT16
ExecStart=/home/oleg/VideoT16/scripts/run_config_web.sh --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
