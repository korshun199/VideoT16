[Unit]
Description=VideoT16: локальное распознавание через Raspberry Pi
Wants=dev-video0.device dev-dri-card1.device
After=dev-video0.device dev-dri-card1.device local-fs.target

[Service]
Type=simple
User=oleg
Group=oleg
SupplementaryGroups=video render
WorkingDirectory=/home/oleg/VideoT16
ExecStartPre=/bin/sh -c 'until test -e /dev/video0 && test -e /dev/dri/by-path/platform-1f00144000.vec-card; do sleep 2; done'
ExecStart=/home/oleg/VideoT16/run_raspberry.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
