#!/usr/bin/env bash

set -Eeuo pipefail

# Устанавливает порог уверенности VideoT16 и перезапускает сервис.
if [[ $# != 1 || ! "$1" =~ ^[0-9]+$ || "$1" -lt 1 || "$1" -gt 100 ]]; then
    printf 'Использование: conf ПРОЦЕНТ\nДиапазон: 1..100\n' >&2
    exit 2
fi

printf '%s\n' "$1" > /home/oleg/VideoT16/confidence.conf
sudo systemctl restart videot16.service
sleep 2
printf 'Порог уверенности: %s%%\n' "$1"
sudo journalctl -u videot16.service -n 0 -f -o cat \
    | grep --line-buffered -E 'confidence=|Запуск Raspberry Pi:'
