[Unit]
Description=VideoT16: локальное распознавание через Raspberry Pi
After=local-fs.target systemd-udev-settle.service

[Service]
Type=simple
User=oleg
Group=oleg
SupplementaryGroups=video render
WorkingDirectory=/home/oleg/VideoT16
ExecStartPre=/bin/sh -c 'until test -e /dev/video0 && test "$(cat /sys/class/drm/card1-Composite-1/status 2>/dev/null)" = connected; do sleep 2; done'
ExecStart=/home/oleg/VideoT16/run_raspberry.sh
Nice=10
CPUQuota=75%
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=basic.target
